# Environment Variables for VoltShare
# Copy this file to .env and fill in the values

# ── Database (MySQL 8.0) ─────────────────────────────
MYSQL_PASSWORD="your-mysql-password"
DATABASE_URL="mysql://root:your-mysql-password@localhost:3306/voltshare"

# ── Redis ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Auth ──────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# ── Google Maps ───────────────────────────────────────
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ── Open Charge Map ───────────────────────────────────
OPEN_CHARGE_MAP_API_KEY="your-open-charge-map-api-key"

# ── Payment (Razorpay) ───────────────────────────────
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# ── Payment (Stripe – alternative) ───────────────────
STRIPE_SECRET_KEY="your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# ── Firebase (Push Notifications) ────────────────────
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_PRIVATE_KEY="your-firebase-private-key"
FIREBASE_CLIENT_EMAIL="your-firebase-client-email"

# ── Email (SendGrid) ─────────────────────────────────
SENDGRID_API_KEY="your-sendgrid-api-key"
SENDGRID_FROM_EMAIL="noreply@voltshare.com"

# ── Cloud Storage (AWS S3) ───────────────────────────
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_S3_BUCKET="voltshare-uploads"
AWS_REGION="ap-south-1"

# ── App Config ────────────────────────────────────────
NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:3000"
PLATFORM_FEE_PERCENT=10

# ── Client App (Next.js) ──────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:4000/api"
NEXT_PUBLIC_RAZORPAY_KEY_ID="your-razorpay-key-id"
