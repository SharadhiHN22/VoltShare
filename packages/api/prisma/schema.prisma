// ── Prisma Schema for VoltShare (MySQL 8.0) ──────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────

enum UserRole {
  SEEKER
  HOST
  ADMIN
}

enum ChargerType {
  LEVEL_1
  LEVEL_2
  DC_FAST
}

enum ConnectorType {
  TYPE_1
  TYPE_2
  CCS_1
  CCS_2
  CHAdeMO
  TESLA
  GB_T
}

enum ChargerStatus {
  ACTIVE
  INACTIVE
  PENDING_APPROVAL
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// ── Models ───────────────────────────────────────────

model User {
  id           String   @id @default(uuid()) @db.VarChar(36)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @db.VarChar(255)
  name         String   @db.VarChar(100)
  phone        String?  @db.VarChar(20)
  role         UserRole
  avatarUrl    String?  @db.VarChar(500)
  isVerified   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  chargers         Charger[]
  seekerBookings   Booking[]      @relation("Seeker")
  paymentsMade     Payment[]      @relation("Payer")
  paymentsReceived Payment[]      @relation("Payee")
  reviews          Review[]
  notifications    Notification[]
  vehicles         Vehicle[]

  @@map("users")
}

model Vehicle {
  id            String        @id @default(uuid()) @db.VarChar(36)
  userId        String        @db.VarChar(36)
  make          String        @db.VarChar(50)
  model         String        @db.VarChar(50)
  year          Int
  connectorType ConnectorType
  batteryCapacity Float?
  registrationNumber String?  @db.VarChar(50)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("vehicles")
}

model Charger {
  id                String        @id @default(uuid()) @db.VarChar(36)
  hostId            String        @db.VarChar(36)
  title             String        @db.VarChar(200)
  description       String?       @db.Text
  latitude          Decimal       @db.Decimal(10, 8)
  longitude         Decimal       @db.Decimal(11, 8)
  address           String        @db.VarChar(500)
  chargerType       ChargerType
  connectorType     ConnectorType
  kwRating          Decimal       @db.Decimal(6, 2)
  pricePerKwh       Decimal?      @db.Decimal(8, 2)
  pricePerHour      Decimal?      @db.Decimal(8, 2)
  status            ChargerStatus @default(PENDING_APPROVAL)
  availabilityHours Json
  photoUrls         Json?         // JSON array for MySQL compatibility
  avgRating         Decimal       @default(0.00) @db.Decimal(3, 2)
  totalReviews      Int           @default(0)
  isPublicStation   Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  host     User      @relation(fields: [hostId], references: [id], onDelete: Cascade)
  bookings Booking[]
  reviews  Review[]

  @@index([hostId])
  @@index([status])
  @@index([chargerType])
  @@index([connectorType])
  @@index([latitude, longitude])
  @@map("chargers")
}

model Booking {
  id          String        @id @default(uuid()) @db.VarChar(36)
  seekerId    String        @db.VarChar(36)
  chargerId   String        @db.VarChar(36)
  startTime   DateTime
  endTime     DateTime
  status      BookingStatus @default(PENDING)
  totalAmount Decimal       @db.Decimal(10, 2)
  qrCode      String?       @db.VarChar(255)
  notes       String?       @db.VarChar(500)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  seeker  User     @relation("Seeker", fields: [seekerId], references: [id], onDelete: Cascade)
  charger Charger  @relation(fields: [chargerId], references: [id], onDelete: Cascade)
  payment Payment?
  review  Review?

  @@unique([chargerId, startTime, endTime])
  @@index([seekerId])
  @@index([chargerId])
  @@index([status])
  @@map("bookings")
}

model Payment {
  id              String        @id @default(uuid()) @db.VarChar(36)
  bookingId       String        @unique @db.VarChar(36)
  payerId         String        @db.VarChar(36)
  payeeId         String        @db.VarChar(36)
  amount          Decimal       @db.Decimal(10, 2)
  platformFee     Decimal       @db.Decimal(10, 2)
  hostPayout      Decimal       @db.Decimal(10, 2)
  currency        String        @default("INR") @db.VarChar(10)
  status          PaymentStatus @default(PENDING)
  transactionId   String?       @db.VarChar(255)
  gatewayResponse Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payer   User    @relation("Payer", fields: [payerId], references: [id], onDelete: Cascade)
  payee   User    @relation("Payee", fields: [payeeId], references: [id], onDelete: Cascade)

  @@index([payerId])
  @@index([payeeId])
  @@index([status])
  @@map("payments")
}

model Review {
  id         String   @id @default(uuid()) @db.VarChar(36)
  bookingId  String   @unique @db.VarChar(36)
  reviewerId String   @db.VarChar(36)
  chargerId  String   @db.VarChar(36)
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  booking  Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  reviewer User    @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
  charger  Charger @relation(fields: [chargerId], references: [id], onDelete: Cascade)

  @@index([reviewerId])
  @@index([chargerId])
  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid()) @db.VarChar(36)
  userId    String   @db.VarChar(36)
  title     String   @db.VarChar(200)
  message   String   @db.VarChar(1000)
  isRead    Boolean  @default(false)
  type      String   @db.VarChar(50)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}
